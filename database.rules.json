{
  "rules": {
    "lobbies": {
      "$lobbyId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('hostId').val() === auth.uid) || (data.exists() && (data.child('hostId').val() === auth.uid || data.child('guestId').val() === auth.uid || (!data.hasChild('guestId') && newData.child('guestId').val() === auth.uid))))",
        "hostId": {
          ".validate": "newData.isString() && (!data.exists() || data.val() === newData.val())"
        },
        "guestId": {
          ".validate": "newData.isString()"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(LOBBY_SETUP|rps|hostPicks|guestPicks|game)$/) && (!data.exists() || data.val() !== 'game' || newData.val() === 'game' || auth.uid === data.parent().child('hostId').val())"
        },
        "game": {
          "current": {
            "number": { ".validate": "newData.isNumber()" },
            "step": { ".validate": "newData.isString() && newData.val().matches(/^(characters|winnerCharacter|loserCharacter|homeBan|awayBan|ban|pick|playing)$/)" },
            "characters": {
              "$uid": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40 && ($uid === root.child('lobbies').child($lobbyId).child('hostId').val() || $uid === root.child('lobbies').child($lobbyId).child('guestId').val())" }
            },
            "bans": { "$i": { ".validate": "newData.isString()" } },
            "stage": { ".validate": "newData.isString()" },
            "winnerId": { ".validate": "newData.isString()" },
            "loserId": { ".validate": "newData.isString()" },
            "extraBan": { ".validate": "newData.isString()" },
            "reports": {
              "$uid": { ".validate": "newData.isString() && ($uid === root.child('lobbies').child($lobbyId).child('hostId').val() || $uid === root.child('lobbies').child($lobbyId).child('guestId').val()) && (newData.val() === root.child('lobbies').child($lobbyId).child('hostId').val() || newData.val() === root.child('lobbies').child($lobbyId).child('guestId').val()) && (data.val() === newData.val() || auth.uid === $uid)" }
            }
          },
          "wins": {
            "$uid": { ".validate": "newData.isNumber() && ($uid === root.child('lobbies').child($lobbyId).child('hostId').val() || $uid === root.child('lobbies').child($lobbyId).child('guestId').val())" }
          },
          "matchWinner": {
            ".validate": "newData.isString() && (newData.val() === root.child('lobbies').child($lobbyId).child('hostId').val() || newData.val() === root.child('lobbies').child($lobbyId).child('guestId').val())"
          }
        },
        "sides": {
          "home": { ".validate": "newData.isString()" },
          "away": { ".validate": "newData.isString()" }
        },
        "rps": {
          "picks": {
            "$uid": {
              ".validate": "($uid === root.child('lobbies').child($lobbyId).child('hostId').val() || $uid === root.child('lobbies').child($lobbyId).child('guestId').val()) && (newData.val() === 'rock' || newData.val() === 'paper' || newData.val() === 'scissors')"
            }
          },
          "winner": {
            ".validate": "newData.isString() && (newData.val() === 'draw' || newData.val() === root.child('lobbies').child($lobbyId).child('hostId').val() || newData.val() === root.child('lobbies').child($lobbyId).child('guestId').val())"
          }
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || data.val() === newData.val())"
        }
      }
    }
  }
}

